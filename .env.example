# Copy to .env (Bun loads it automatically).
PORT=8795
DB_PATH=./data/movie-night.sqlite
# TMDB "API Read Access Token" (v4) or v3 API key: https://www.themoviedb.org/settings/api
TMDB_TOKEN=
# Cloudflare Access (set both to require a valid Access JWT on requests coming through the tunnel).
# ACCESS_AUD may be a comma-separated list of application AUD tags.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Comma-separated emails auto-added as admins on first visit.
ADMIN_EMAILS=
# Public URL shown to people who need to sign in with Google.
PUBLIC_URL=https://movienight.example.com
# "Who's watching?" picker without real auth: localhost (default, dev only), lan (anyone on the network; trust-based), off.
PICKER=localhost
