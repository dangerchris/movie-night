# Edit User and the paths to match your server, then install with:
#   sudo cp deploy/movie-night.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now movie-night
[Unit]
Description=Movie Night
After=network-online.target

[Service]
User=movienight
WorkingDirectory=/home/movienight/movie-night
ExecStart=/home/movienight/.bun/bin/bun src/server.ts
Restart=on-failure
MemoryMax=256M
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
